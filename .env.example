# Database
DATABASE_URL=

# Authentication (min 32 chars for AUTH_SECRET)
AUTH_SECRET=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Media storage: local | s3 | cloudinary
STORAGE_PROVIDER=

# Local storage (when STORAGE_PROVIDER=local)
STORAGE_LOCAL_PATH=

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rajniti-ka-akhada

# Facebook Page auto-publish (server-side only — never expose to frontend)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Scheduled publishing cron protection
CRON_SECRET=

# Optional analytics
NEXT_PUBLIC_GA_ID=
