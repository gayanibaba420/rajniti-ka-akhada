# Server
PORT=4000
NODE_ENV=production

# CORS — comma-separated frontend origins
CORS_ORIGINS=https://www.rajnitikaakhada.com,http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rajniti

# Authentication (min 32 chars)
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public site URL (for Facebook links, canonical URLs)
SITE_URL=https://www.rajnitikaakhada.com

# Media storage: local | s3 | cloudinary
STORAGE_PROVIDER=cloudinary

# Local storage (when STORAGE_PROVIDER=local)
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# Cloudinary (recommended for EC2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rajniti-ka-akhada

# Facebook Page auto-publish
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Scheduled publishing cron protection
CRON_SECRET=
